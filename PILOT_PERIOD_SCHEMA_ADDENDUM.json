  "p_eval_contract": {
    "input": "C_p = annotation[object_id]['period']",
    "source_length": "L = int(annotation['length'])",
    "validity_rule": "C_p is non-empty and every item is exactly two Python ints satisfying 0 <= s < e <= L",
    "invalid_policy": "global_gate_failure; never filter a track and never fall back",
    "span_rule": "D_p,k = float64(e_p,k - s_p,k)",
    "formula": "P_eval,p = numpy.median(numpy.asarray([e-s for [s,e] in C_p], dtype=numpy.float64))",
    "aggregation": "NumPy default median; for even K, arithmetic mean of the two central sorted spans",
    "unit": "source_frame_boundary_units",
    "forbidden_alternatives": [
      "inclusive end or plus-one duration",
      "harmonic mean",
      "weighted median",
      "trimmed statistic",
      "action-conditioned branch",
      "count fallback",
      "density fallback",
      "periodicity fallback",
      "bbox-derived fallback",
      "development-selected alternative"
    ],
    "count_relation_use": "vault_integrity_receipt_only; count is not an input to P_eval",
    "freeze_order": "compute only in a separately permissioned evaluator after predictions and selector traces are immutable"
  },
  "harmonic_gate": {
    "predicted_track_period": "hat_P_p = NumPy median of valid pre-vault window selector outputs in source-frame units",
    "classes": [
      0.5,
      1.0,
      2.0
    ],
    "distance": "d_p,h = abs(hat_P_p / (h * P_eval,p) - 1)",
    "relative_tolerance": 0.1,
    "no_match_class": "off-grid",
    "nonfinite_class": "off-grid",
    "correction_allowed": false,
    "filtering_allowed": false,
    "rerun_or_retune_allowed": false
  },
  "clock_contract": {
    "sample_index_formula": "q_j = clip(round(j*(L-1)/(T-1)),0,L-1)",
    "target_length": 320,
    "sample_clock_semantics": "sampled source-frame centers in [0,L-1]",
    "label_clock_semantics": "source-frame boundaries in [0,L]",
    "conversion_rule": "selector must emit source-clock periods directly after duplicate-clock collapse and valid-cell interpolation",
    "inverse_index_lookup_allowed": false,
    "label_resampling_allowed": false,
    "uniform_grid_period_policy": "fail_closed",
    "forbidden_conversion_branches": [
      "T/L",
      "(T-1)/(L-1)",
      "nearest sampled index",
      "data-dependent conversion"
    ],
