  "code_audit": [
    {
      "symbol": "PAMSEncoder._forward_with_pre_pe",
      "finding": "The diagnosed historical head input was the normalized Transformer embedding after sinusoidal absolute position encoding."
    },
    {
      "symbol": "PeriodHead",
      "finding": "The 512->128->1 GELU MLP is pointwise and has no temporal operator that can distinguish pose phase from a shared absolute-position template."
    },
    {
      "symbol": "train_sshead",
      "finding": "The encoder runs under no_grad and the head receives a detached input, but the Period Head itself remains differentiable. Backward, finite-gradient checks, AdamW steps, nonzero log gradients, and approximately 10% parameter movement rule out a missing head-gradient path."
    },
    {
      "symbol": "SSHeadLoss.compute",
      "finding": "Cycle and spectral terms are confidence-gated; variance is not. The spectral ratio is scale-invariant, the variance hinge has zero derivative at exact std=0, and fewer-than-two-valid-frame rows add a constant variance penalty."
    },
    {
      "symbol": "_valid_stream_standard_deviations",
      "finding": "Rows with fewer than two valid frames are encoded as std=0 and therefore inflate collapse counts and force stream_std_min=0."
    }
