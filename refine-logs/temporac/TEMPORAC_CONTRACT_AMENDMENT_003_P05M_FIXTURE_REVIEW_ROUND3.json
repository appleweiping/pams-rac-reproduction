  "blockers": [
    {
      "affected_prior_closure": "R2-B2",
      "classification": "blocking",
      "evidence": [
        "Amendment JSON:1258-1290 requires each process witness to embed complete post-scoring module-origin data, native-image digest and sandbox witness.",
        "Amendment JSON:1209-1221 and 1388-1402 makes each child's entire successful stdout exactly a nine-key role observation that contains none of those process-witness fields; successful stderr is empty and stdin is only the worker request.",
        "Amendment JSON:1431-1437 nevertheless requires the controller to verify those actual child values, but defines no extra descriptor, pipe, file, sidecar, monitor, tracer or attestation transport.",
        "Amendment JSON:1405-1442 makes controller stdout exactly runner evidence, which contains child witnesses but no controller witness; JSON:1463-1466 says P2 constructs the controller witness only after exit, when post-scoring sys.modules is no longer externally observable from the OS process handle.",
        "Markdown:520 calls the working root read-only, while JSON:987 authoritatively makes $WORK/empty writable. Every role uses the same token and no rule binds distinct mount identities, final emptiness, write prohibition or cross-role isolation."
      ],
      "exact_minimal_fix": [
        "Define one exact parent-observable attestation transport for each role, including descriptor/path identity, creator, canonical bytes, schema, ordering, lifetime and hash preimage; include any monitor or launcher in a freshly reviewed executable/runtime closure.",
        "Carry or externally attest the complete post-scoring module-origin/native-image/sandbox observations and specify how completeness is checked rather than copied from an expected allowlist.",
        "Attest controller state before exit on the same closed chain.",
        "Make work roots explicitly read-only, or bind three distinct per-role mount identities with cross-role access forbidden and initial/final tree witnesses."
      ],
      "finding": "The child and controller process witnesses claim actual runtime observations that cannot be constructed or independently verified from the only frozen I/O, while an unfrozen writable work mount permits an unbound substitute channel.",
      "id": "R3-B1",
      "impact": "Expected manifests can be copied into witnesses without proving the processes' actual post-scoring state, and production/reference isolation is not mechanically guaranteed.",
      "status": "OPEN",
      "title": "Process-witness attestation and work-mount isolation are not closed"
    },
    {
      "affected_prior_closure": "R2-B2 outer PASS authority",
      "classification": "blocking",
      "evidence": [
        "p2_verifier_closure_sha256 occurs only as one gate-evidence closed key at Amendment JSON:1455 and as the prose label P2-verifier 17-member closure hash at Markdown:680.",
        "No member array, preimage, digest rule, equality to production_executable_closure_sha256, verifier entry point, runtime/origin closure, candidate-review relation or process witness is defined for that field.",
        "Amendment JSON:1037 limits repository bytes executable in P2/K7 to the candidate snapshot but does not identify which bytes implement the external PASS-writing verifier.",
        "None of JSON:1462-1470's construction or PASS rules compares the field with a recomputed executable closure."
      ],
      "exact_minimal_fix": [
        "If P2 uses the 17 candidate members, require p2_verifier_closure_sha256 to equal the freshly reviewed production_executable_closure_sha256, identify the verifier entry point and bind its actual runtime/module/process witness before PASS.",
        "Otherwise define a separate external verifier member list, exact raw-byte preimage, runtime/origin closure, independent review and execution witness, and recompute it before setting status PASS."
      ],
      "finding": "The sole PASS writer is not bound to any uniquely constructible executable closure.",
      "id": "R3-B2",
      "impact": "A canonical gate-evidence object can carry an arbitrary 64-hex verifier digest while satisfying every stated construction step, so P2 PASS remains self-asserted at its final authority boundary.",
      "status": "OPEN",
      "title": "P2 verifier closure is a bare unconstrained digest"
    }
  ],
